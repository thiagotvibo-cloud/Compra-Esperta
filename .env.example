# GEMINI_API_KEY: Opcional — ativa dicas de IA
# Configurado via painel de Secrets
GEMINI_API_KEY=

# DATABASE_URL: String de conexão do PostgreSQL
# Exemplo: postgres://usuario:senha@host:porta/banco
DATABASE_URL=

# SESSION_SECRET: Secret para criptografar os cookies de sessão
# Exemplo: um-segredo-muito-forte-aqui
SESSION_SECRET=
