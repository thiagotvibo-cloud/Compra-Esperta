<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
  <rect width="512" height="512" fill="#ffffff"/>
  
  <g transform="translate(0, 30)">
    <!-- Basket -->
    <g transform="translate(100, 200)">
      <path d="M 30 50 L 282 50 L 240 180 C 235 200 210 210 190 210 L 122 210 C 102 210 77 200 72 180 Z" fill="#FBBF24" stroke="#451A03" stroke-width="16" stroke-linejoin="round"/>
      <path d="M 10 50 L 302 50" stroke="#451A03" stroke-width="24" stroke-linecap="round"/>
      
      <!-- Slots in basket -->
      <path d="M 90 80 L 100 180" stroke="#451A03" stroke-width="16" stroke-linecap="round"/>
      <path d="M 156 80 L 156 180" stroke="#451A03" stroke-width="16" stroke-linecap="round"/>
      <path d="M 222 80 L 212 180" stroke="#451A03" stroke-width="16" stroke-linecap="round"/>

      <!-- Handle -->
      <path d="M 80 50 L 156 -80 L 180 -80" fill="none" stroke="#FBBF24" stroke-width="24" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M 80 50 L 156 -80 L 180 -80" fill="none" stroke="#451A03" stroke-width="16" stroke-linecap="round" stroke-linejoin="round"/>
      
      <path d="M 232 50 L 186 -30" fill="none" stroke="#FBBF24" stroke-width="24" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M 232 50 L 186 -30" fill="none" stroke="#451A03" stroke-width="16" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
    
    <!-- Falling Items -->
    <g transform="translate(240, 160)">
      <!-- Apple -->
      <circle cx="0" cy="0" r="40" fill="#EF4444" stroke="#451A03" stroke-width="12"/>
      <path d="M 0 -30 Q 15 -60 30 -50" fill="none" stroke="#16A34A" stroke-width="12" stroke-linecap="round"/>
    </g>
    
    <g transform="translate(340, 140) rotate(30)">
      <!-- Avocado -->
      <path d="M 0 -40 C 30 -40 40 10 40 40 C 40 70 20 80 0 80 C -20 80 -40 70 -40 40 C -40 10 -30 -40 0 -40 Z" fill="#4ADE80" stroke="#451A03" stroke-width="12" stroke-linejoin="round"/>
      <circle cx="0" cy="40" r="20" fill="#78350F"/>
    </g>

    <g transform="translate(160, 120) rotate(-20)">
      <!-- Orange/Lemon -->
      <circle cx="0" cy="0" r="35" fill="#FDE047" stroke="#451A03" stroke-width="12"/>
      <path d="M 0 -30 Q -10 -50 -25 -45" fill="none" stroke="#16A34A" stroke-width="12" stroke-linecap="round"/>
    </g>
    
    <!-- Leaves -->
    <g transform="translate(120, 220) rotate(-45)">
      <path d="M 0 0 C 20 -20 40 0 20 20 C 0 40 -20 20 0 0 Z" fill="#16A34A" stroke="#451A03" stroke-width="8" stroke-linejoin="round"/>
    </g>
    
    <g transform="translate(380, 260) rotate(60)">
      <path d="M 0 0 C 20 -20 40 0 20 20 C 0 40 -20 20 0 0 Z" fill="#16A34A" stroke="#451A03" stroke-width="8" stroke-linejoin="round"/>
    </g>
    
    <g transform="translate(200, 60) rotate(15)">
      <path d="M 0 0 C 20 -20 40 0 20 20 C 0 40 -20 20 0 0 Z" fill="#16A34A" stroke="#451A03" stroke-width="8" stroke-linejoin="round"/>
    </g>
  </g>
</svg>